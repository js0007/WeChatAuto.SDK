<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WeChatAuto.Client</RootNamespace>
    <AssemblyName>WeChatAuto.Client</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- .NET Framework 4.8：System.Text.Json 框架未内置，需 NuGet 引入（net6.0+ 已内置）。
       System.Net.Http 在 netfx 里是 out-of-band 程序集，SDK 项目需显式引用。
       ReferenceAssemblies 让没有安装 4.8 targeting pack 的机器（如 CI）也能构建 net48。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
